{
  "name": "@developersdoc/cli",
  "version": "0.1.1",
  "description": "DevelopersDoc sync CLI",
  "type": "module",
  "bin": {
    "developersdoc": "./bin/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
    "test": "tsx --test src/**/*.test.ts",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "developersdoc",
    "cli",
    "sync"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "commander": "^14.0.3",
    "fast-glob": "^3.3.3",
    "prompts": "^2.4.2",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/prompts": "^2.4.9",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
